<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_review_list" model="ir.ui.view">
        <field name="name">product.review.list</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <list string="Product Reviews"
                  decoration-success="state == 'approved'"
                  decoration-warning="state == 'pending'"
                  decoration-danger="state == 'rejected'">
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="title"/>
                <field name="rating"/>
                <field name="state"/>
                <field name="create_date"/>
                <button name="action_approve" type="object" string="Approve"
                        icon="fa-check" invisible="state == 'approved'"/>
                <button name="action_reject" type="object" string="Reject"
                        icon="fa-times" invisible="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_product_review_form" model="ir.ui.view">
        <field name="name">product.review.form</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <form string="Product Review">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-success" invisible="state == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-danger" invisible="state == 'rejected'"/>
                    <button name="action_pending" type="object" string="Set Pending"
                            invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <field name="rating"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="title"/>
                        <field name="review"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_review_search" model="ir.ui.view">
        <field name="name">product.review.search</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="group_product" string="By Product" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_product_reviews" model="ir.actions.act_window">
        <field name="name">Product Reviews</field>
        <field name="res_model">product.review</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <!-- Website → Configuration → Product Reviews -->
    <menuitem id="menu_product_reviews"
              name="Product Reviews"
              parent="website.menu_website_configuration"
              action="action_product_reviews"
              sequence="30"/>

    <!-- eCommerce → Configuration → Product Reviews -->
    <menuitem id="menu_product_reviews_ecommerce"
              name="Product Reviews"
              parent="website_sale.menu_ecommerce_settings"
              action="action_product_reviews"
              sequence="50"/>

</odoo>
