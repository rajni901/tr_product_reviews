<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="product_reviews_section" inherit_id="website_sale.product"
              name="Product Reviews &amp; Ratings">
        <xpath expr="//section[@id='product_detail']" position="after">

            <!-- Flash messages — always visible regardless of allow_reviews -->
            <t t-set="review_success" t-value="request.params.get('review_success')"/>
            <t t-set="review_error" t-value="request.params.get('review_error')"/>
            <div t-if="review_success" class="container mt-3">
                <div class="alert alert-success">
                    ✓ Thank you! Your review has been submitted and is pending approval.
                </div>
            </div>
            <div t-if="review_error" class="container mt-3">
                <div class="alert alert-danger">
                    ✗ <t t-esc="review_error"/>
                </div>
            </div>

            <section id="tr_product_reviews" class="container mt-5 mb-5"
                     t-if="product.allow_reviews">

                <!-- Average Rating Summary -->
                <div class="tr-review-summary mb-4">
                    <h3 class="tr-reviews-title">Customer Reviews</h3>
                    <t t-if="product.review_count > 0">
                        <div class="tr-avg-rating">
                            <span class="tr-avg-score" t-esc="'%.1f' % product.avg_rating"/>
                            <div class="tr-stars-display">
                                <t t-set="avg" t-value="product.avg_rating"/>
                                <t t-foreach="range(1, 6)" t-as="i">
                                    <span t-att-class="'tr-star ' + ('tr-star-full' if i &lt;= avg else ('tr-star-half' if i - 0.5 &lt;= avg else 'tr-star-empty'))">★</span>
                                </t>
                            </div>
                            <span class="tr-review-count">
                                Based on <t t-esc="product.review_count"/> review(s)
                            </span>
                        </div>
                    </t>
                    <t t-else="">
                        <p class="text-muted">No reviews yet. Be the first to review!</p>
                    </t>
                </div>

                <!-- Approved Reviews List -->
                <t t-set="approved_reviews" t-value="product.review_ids.filtered(lambda r: r.state == 'approved')"/>
                <t t-if="approved_reviews">
                    <div class="tr-reviews-list mb-4">
                        <t t-foreach="approved_reviews" t-as="rev">
                            <div class="tr-review-card">
                                <div class="tr-review-header">
                                    <div class="tr-review-stars">
                                        <t t-foreach="range(1, 6)" t-as="i">
                                            <span t-att-class="'tr-star ' + ('tr-star-full' if i &lt;= rev.rating_int else 'tr-star-empty')">★</span>
                                        </t>
                                    </div>
                                    <strong class="tr-review-title" t-esc="rev.title"/>
                                </div>
                                <div class="tr-review-meta">
                                    <span t-esc="rev.partner_id.name"/> —
                                    <span t-field="rev.create_date" t-options='{"widget": "date"}'/>
                                </div>
                                <div class="tr-review-body" t-esc="rev.review"/>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Review Form -->
                <div class="tr-review-form-section">
                    <h4>Write a Review</h4>
                    <t t-if="request.env.user._is_public()">
                        <div class="alert alert-info">
                            Please <a t-att-href="'/web/login?redirect=' + request.httprequest.path">log in</a>
                            to write a review.
                        </div>
                    </t>
                    <t t-else="">
                        <form id="tr_review_form" class="tr-review-form"
                              method="post" action="/shop/product/review/submit">
                            <input type="hidden" name="product_id" id="tr_product_id" t-att-value="product.id"/>

                            <!-- Star Rating — Pure CSS Radio -->
                            <div class="tr-form-group mb-3">
                                <label class="form-label fw-bold">Your Rating *</label>
                                <div class="tr-star-rating">
                                    <input type="radio" id="star5" name="rating" value="5"/>
                                    <label for="star5" title="5 stars">★</label>
                                    <input type="radio" id="star4" name="rating" value="4"/>
                                    <label for="star4" title="4 stars">★</label>
                                    <input type="radio" id="star3" name="rating" value="3"/>
                                    <label for="star3" title="3 stars">★</label>
                                    <input type="radio" id="star2" name="rating" value="2"/>
                                    <label for="star2" title="2 stars">★</label>
                                    <input type="radio" id="star1" name="rating" value="1"/>
                                    <label for="star1" title="1 star">★</label>
                                </div>
                            </div>

                            <!-- Title -->
                            <div class="tr-form-group mb-3">
                                <label class="form-label fw-bold" for="tr_review_title">Review Title *</label>
                                <input type="text" id="tr_review_title" name="title"
                                       class="form-control" placeholder="Summarize your review"/>
                            </div>

                            <!-- Review text -->
                            <div class="tr-form-group mb-3">
                                <label class="form-label fw-bold" for="tr_review_body">Your Review</label>
                                <textarea id="tr_review_body" name="review" class="form-control" rows="4"
                                          placeholder="Share your experience with this product..."/>
                            </div>

                            <div id="tr_review_message" class="mb-3" style="display:none;"/>

                            <button type="submit" class="btn btn-primary" id="tr_submit_review">
                                Submit Review
                            </button>
                        </form>
                    </t>
                </div>

            </section>
        </xpath>
    </template>

</odoo>
