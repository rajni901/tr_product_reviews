<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_reviews" model="ir.ui.view">
        <field name="name">product.template.reviews</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_website"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Reviews &amp; Ratings" name="reviews_tab">
                    <group>
                        <field name="allow_reviews"/>
                        <field name="avg_rating" readonly="1"/>
                        <field name="review_count" readonly="1"/>
                    </group>
                    <field name="review_ids" readonly="1">
                        <list string="Reviews"
                              decoration-success="state == 'approved'"
                              decoration-warning="state == 'pending'">
                            <field name="partner_id"/>
                            <field name="rating"/>
                            <field name="title"/>
                            <field name="state"/>
                            <field name="create_date"/>
                            <button name="action_approve" type="object"
                                    string="Approve" invisible="state == 'approved'"/>
                            <button name="action_reject" type="object"
                                    string="Reject" invisible="state == 'rejected'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
